# Contract Expiry Radar — optional settings. Copy to .env to change them.
# When deployed (e.g. Streamlit Community Cloud), set these as the host's
# "Secrets" instead of a .env file — see README -> Deploy.

# Where the SQLite database lives. Default: ./data/contract_expiry_radar.db
CER_DB_PATH=./data/contract_expiry_radar.db

# Required to open the internal dashboard (pages/01_Internal_Dashboard.py).
# Without it, that page refuses to unlock for anyone, including you.
# Pick your own value — this is just a placeholder, not a real default.
ADMIN_PASSWORD=change-me-before-deploying
