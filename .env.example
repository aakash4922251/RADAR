# Contract Expiry Radar — environment variables
# Copy this file to .env and adjust as needed. Nothing here is required to
# run the MVP locally with default settings; all ingestion in this MVP is
# via document upload (see README "Source access"), so no API keys are
# needed for the core pipeline.

# Path to the SQLite database file. Defaults to ./data/contract_expiry_radar.db
# relative to the project root if unset.
CER_DB_PATH=./data/contract_expiry_radar.db

# Reserved for a future compliant, robots.txt-respecting public-source
# connector (see core/ingestion.py:fetch_public_url). Not used by the
# current MVP; ingestion is document-upload only.
ACQUISITION_ENABLED=true
CPPP_ENABLED=true
CPPP_POLL_INTERVAL_MINUTES=15
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RATE_LIMIT_DELAY_SECONDS=1
ACQUISITION_STORAGE_ROOT=./data/acquired
